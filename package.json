{
  "name": "core-companion",
  "productName": "COre",
  "version": "12.0.0",
  "private": true,
  "description": "COre: a black liquid orb desktop companion that talks through Claude Code (no API key) or a free local model.",
  "main": "boot.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "dist": "electron-builder --win nsis --x64",
    "e2e": "node --test --test-concurrency=1 test-e2e/app.e2e.js",
    "benchmark": "node scripts/benchmark.js --out docs/BENCHMARKS.md",
    "validate:providers": "node scripts/real-providers.js --out docs/REAL-PROVIDERS.md"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "electron-updater": "6.8.10",
    "kokoro-js": "1.2.1",
    "pdfjs-dist": "4.10.38",
    "qrcode-generator": "1.4.4",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "playwright-core": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rawsushies/core-ai-companion.git"
  },
  "author": {
    "name": "rawsushies"
  },
  "build": {
    "appId": "com.rawsushies.core",
    "productName": "COre",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "boot.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!test/**/*",
      "!assets/brand/v11/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "COre-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COre",
      "uninstallDisplayName": "COre",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rawsushies",
        "repo": "core-ai-companion",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES.md"
    },
    "extraResources": [
      {
        "from": "vendor/cortex",
        "to": "cortex",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
